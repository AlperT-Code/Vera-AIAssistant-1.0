# Bu dosyayı .env olarak kopyalayıp kendi bilgilerinizi girin.
# Copy this file to .env and fill in your own values.

# OpenWeatherMap
WEATHER_KEY=

# Groq (chat/AI)
GROQ_API_KEY=

# Tuya akıllı ampul
BULB_DEVICE_ID=
BULB_LOCAL_KEY=
BULB_IP=

# Spotify API (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# MySQL veritabanı
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=vera_db
